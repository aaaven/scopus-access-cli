include README.md CHANGELOG.md CONTRIBUTING.md AGENTS.md
include pyproject.toml setup.cfg .gitignore
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include examples *.md *.json
global-exclude __pycache__ *.py[cod] .DS_Store *.sqlite *.sqlite3 *.db *.jsonl *.key *.pem
prune dist
prune build
prune runtime
prune restricted_metadata
prune .scopus-access
